#score {
    text-align: center;
}

#game {
    width: 100vw;
    height: 100vh;
    margin: 0;
    position: relative;
    background-image:url(abcp.png);
    background-size: cover;
    background-position: center;
    overflow: hidden;
}

#star {
    height: 100px;
    width: 100px;
    background-image: url("starp.png");
    position: absolute;
    bottom: 20px;
    left: 100px;
    background-size: cover;
}
#alien {
    height: 100px;
    width: 100px;
    position: absolute;
    bottom: 20px;
    background-image: url("alienpng.png");
    background-size: cover;
    animation: alien 2s infinite;
}
@keyframes alien {
    0%{left: 500px;}
    100%{left: -50px;}
}

.jump-animation {
    animation: jump 0.5s;
}

@keyframes jump {
    0%{top: 500px;}
    50%{top: 150px;}
    75%{top: 150px;}
    100%{top: 500px;}
}
